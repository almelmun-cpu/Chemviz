{
  "name": "chemviz-server",
  "version": "1.0.0",
  "description": "ChemViz API server - proxy for PubChem data",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --forceExit --detectOpenHandles --testPathPattern='../tests/server'"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "jest": {
    "roots": ["../tests"],
    "testMatch": ["**/?(*.)+(spec|test).[tj]s?(x)"]
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
